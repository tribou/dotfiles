# mise optional CLI tools — global drop-in.
#
# Enable:  cp mise-config.optional.toml.example ~/.config/mise/conf.d/optional.toml
# Then uncomment the tools you want. mise auto-loads ~/.config/mise/conf.d/*.toml
# (alphabetically) and merges [tools] additively over the core config.toml, so
# `mise install` / `mise upgrade` provision these alongside the core runtimes.
#
# Each entry below is optional and additive to the core mise configuration.
# Formulae and casks are installed by mise itself (no Homebrew needed); casks
# are macOS-only (Linux takes only font casks) and install into /Applications.

[tools]
# awscli = "latest"        # pipx backend (AWS CLI v2)
# terraform-ls = "latest"  # ubi backend (HashiCorp terraform-ls GitHub releases)
# navi = "latest"          # ubi backend (cheatsheet tool)
# tlrc = "latest"          # ubi/cargo backend (tldr client)
# tfenv = "latest"

[bootstrap.packages]
# "brew:nmap" = "latest"
# "brew:tree" = "latest"
# "brew:dos2unix" = "latest"
# "brew:tidy-html5" = "latest"
# "brew:ngrok/ngrok/ngrok" = { version = "latest", os = "macos/arm64" }
# "brew:tor" = { version = "latest", os = "macos/arm64" }
# "brew:rename" = { version = "latest", os = "macos/arm64" }
# "brew:renameutils" = { version = "latest", os = "macos/arm64" }
# "brew:vimpager" = { version = "latest", os = "macos/arm64" }
# "brew-cask:firefox" = { version = "latest", os = "macos" }
# "brew-cask:orbstack" = { version = "latest", os = "macos" }
# "brew-cask:bruno" = { version = "latest", os = "macos" }
# "brew-cask:balenaetcher" = { version = "latest", os = "macos" }
# "brew-cask:appcleaner" = { version = "latest", os = "macos" }
