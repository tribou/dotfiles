# Optional Homebrew casks and formulae — global Brewfile.
#
# Enable:  cp Brewfile.optional.example ~/.Brewfile
# Then uncomment what you want. `just install` runs `brew bundle --global
# --no-upgrade` (installs missing entries). `just upgrade` upgrades already-
# installed casks/formulae via `brew upgrade`; run `just install -e
# dotfiles_state=latest` to also force `brew bundle --global --upgrade` (e.g. to
# pull in newly-uncommented entries). Casks are macOS-only — `brew bundle` skips
# cask directives on Linux automatically; formulae apply on every platform.

# --- Casks (macOS only) ---
# cask "firefox"
# cask "orbstack"
# cask "bruno"
# cask "balenaetcher"
# cask "appcleaner"
# cask "imageoptim"
# cask "cmake"
# cask "font-fira-code-nerd-font"
# cask "font-hack-nerd-font"
# cask "font-fontawesome"

# --- Formulae (macOS and Linux via brew) ---
# Tools without a mise backend:
# brew "nmap"
# brew "tree"
# brew "dos2unix"
# brew "tidy-html5"
# Optional macOS-only formulae:
# brew "ngrok/ngrok/ngrok"
# brew "tor"
# brew "tfenv"
# brew "rename"
# brew "renameutils"
# brew "vimpager"
