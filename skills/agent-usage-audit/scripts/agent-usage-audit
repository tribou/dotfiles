#!/usr/bin/env bun
/**
 * Probe the running agent harness for this session's model and token usage
 * and emit one normalized JSON audit record on stdout.
 *
 * Subcommands:
 *   probe --stage STAGE [--session ID]   emit one normalized JSON record
 *
 * Nothing here ever guesses a number: a probe that cannot read real usage
 * emits a record with "source": "unavailable" and a human-readable reason.
 */
import { Database } from "bun:sqlite";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";

const SCHEMA = 1;
const STAGES = ["brainstorming-to-issue", "issue-to-plan", "plan-to-implementation"] as const;
type Stage = (typeof STAGES)[number];

type Harness = "claude-code" | "opencode" | "agy" | "unknown";

const TOKEN_KEYS = ["input", "output", "cache_read", "cache_write", "reasoning"] as const;
type TokenKey = (typeof TOKEN_KEYS)[number];

interface Tokens {
  input: number;
  output: number;
  cache_read: number;
  cache_write: number;
  reasoning: number;
  total: number;
}

interface ChildRecord {
  session_id: string;
  harness: Harness;
  models: string[];
  tokens: Tokens;
}

interface UsageRecord {
  schema: number;
  stage: Stage;
  harness: Harness;
  session_id: string;
  source: string;
  models: string[];
  tokens: Tokens;
  cost_usd: number | null;
  children: ChildRecord[];
  updated_at: string;
  reason?: string;
  verified_rows?: number;
  dropped_rows?: number;
}

function emptyTokens(): Tokens {
  return { input: 0, output: 0, cache_read: 0, cache_write: 0, reasoning: 0, total: 0 };
}

function finalizeTokens(tokens: Tokens): Tokens {
  // Reasoning is a subset of output, never re-added.
  tokens.total = tokens.input + tokens.output + tokens.cache_read + tokens.cache_write;
  return tokens;
}

function utcNow(): string {
  return new Date().toISOString().replace(/\.\d+Z$/, "Z");
}

function detectHarness(): Harness {
  const forced = process.env.AGENT_USAGE_AUDIT_HARNESS;
  if (forced) return forced as Harness;
  if (process.env.OPENCODE || process.env.OPENCODE_SESSION_ID) return "opencode";
  if (process.env.CLAUDECODE || process.env.CLAUDE_CODE_SESSION_ID) return "claude-code";
  if (process.env.AGY_CONVERSATION_ID || process.env.ANTIGRAVITY_CONVERSATION_ID) return "agy";
  return "unknown";
}

function detectSessionId(harness: Harness): string | null {
  const forced = process.env.AGENT_USAGE_AUDIT_SESSION_ID;
  if (forced) return forced;
  if (harness === "claude-code") return process.env.CLAUDE_CODE_SESSION_ID ?? null;
  if (harness === "opencode") return process.env.OPENCODE_SESSION_ID ?? null;
  if (harness === "agy") {
    return process.env.AGY_CONVERSATION_ID ?? process.env.ANTIGRAVITY_CONVERSATION_ID ?? null;
  }
  return null;
}

function makeRecord(
  stage: Stage,
  harness: Harness,
  sessionId: string | null,
  source: string,
  tokens: Tokens,
  models: string[],
  children: ChildRecord[],
  options: { costUsd?: number | null; reason?: string } = {},
): UsageRecord {
  const record: UsageRecord = {
    schema: SCHEMA,
    stage,
    harness,
    session_id: sessionId ?? "unknown",
    source,
    models: [...new Set(models)].sort(),
    tokens: finalizeTokens(tokens),
    cost_usd: options.costUsd ?? null,
    children,
    updated_at: utcNow(),
  };
  if (options.reason) record.reason = options.reason;
  return record;
}

function unavailableRecord(
  stage: Stage,
  harness: Harness,
  sessionId: string | null,
  reason: string,
): UsageRecord {
  return makeRecord(stage, harness, sessionId, "unavailable", emptyTokens(), [], [], { reason });
}

function openSqliteReadonly(dbPath: string): Database {
  // Read-only so a live agent session is never disturbed.
  return new Database(dbPath, { readonly: true });
}

function errorMessage(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}

const OPENCODE_COLUMNS =
  "id, model, cost, tokens_input, tokens_output, tokens_reasoning," +
  " tokens_cache_read, tokens_cache_write";

interface OpencodeRow {
  id: string;
  model: string | null;
  cost: number | null;
  tokens_input: number | null;
  tokens_output: number | null;
  tokens_reasoning: number | null;
  tokens_cache_read: number | null;
  tokens_cache_write: number | null;
}

function opencodeRowTokens(row: OpencodeRow): Tokens {
  const tokens = emptyTokens();
  tokens.input = row.tokens_input ?? 0;
  // opencode keeps reasoning in its own column; the normalized `output` is the
  // billed output including reasoning, and `reasoning` repeats the subset.
  tokens.output = (row.tokens_output ?? 0) + (row.tokens_reasoning ?? 0);
  tokens.reasoning = row.tokens_reasoning ?? 0;
  tokens.cache_read = row.tokens_cache_read ?? 0;
  tokens.cache_write = row.tokens_cache_write ?? 0;
  return finalizeTokens(tokens);
}

function opencodeDbPath(): string {
  return process.env.AGENT_USAGE_AUDIT_OPENCODE_DB
    ?? path.join(homedir(), ".local", "share", "opencode", "opencode.db");
}

function probeOpencode(stage: Stage, sessionId: string): UsageRecord {
  const dbPath = opencodeDbPath();
  if (!existsSync(dbPath)) {
    return unavailableRecord(stage, "opencode", sessionId, `opencode.db not found at ${dbPath}`);
  }
  let db: Database;
  try {
    db = openSqliteReadonly(dbPath);
  } catch (error) {
    return unavailableRecord(stage, "opencode", sessionId, `opencode.db unreadable: ${errorMessage(error)}`);
  }
  let parent: OpencodeRow | null = null;
  let kids: OpencodeRow[] = [];
  try {
    parent = (db.prepare(`SELECT ${OPENCODE_COLUMNS} FROM session WHERE id = ?`).get(sessionId) as OpencodeRow) ?? null;
    kids = db.prepare(`SELECT ${OPENCODE_COLUMNS} FROM session WHERE parent_id = ?`).all(sessionId) as OpencodeRow[];
  } catch (error) {
    return unavailableRecord(stage, "opencode", sessionId, `opencode.db unreadable: ${errorMessage(error)}`);
  } finally {
    db.close();
  }

  if (!parent) {
    return unavailableRecord(stage, "opencode", sessionId, `session ${sessionId} not present in ${dbPath}`);
  }

  const rolledUp = opencodeRowTokens(parent);
  const models: string[] = parent.model ? [parent.model] : [];
  let cost = parent.cost;
  const children: ChildRecord[] = [];
  for (const kid of kids) {
    const kidTokens = opencodeRowTokens(kid);
    if (kid.cost !== null) cost = (cost ?? 0) + kid.cost;
    if (kid.model) models.push(kid.model);
    for (const key of TOKEN_KEYS) rolledUp[key] += kidTokens[key];
    children.push({
      session_id: kid.id,
      harness: "opencode",
      models: kid.model ? [kid.model] : [],
      tokens: kidTokens,
    });
  }

  // Rounding keeps 0.42 + 0.08 from printing as 0.5000000000000001.
  const costUsd = cost === null ? null : Math.round(cost * 1e6) / 1e6;
  return makeRecord(stage, "opencode", sessionId, "builtin-opencode", rolledUp, models, children, { costUsd });
}

function agyConversationsDir(): string {
  return process.env.AGENT_USAGE_AUDIT_AGY_DIR
    ?? path.join(homedir(), ".gemini", "antigravity-cli", "conversations");
}

type PbValue = ["varint", number] | ["bytes", Uint8Array] | ["i32", Uint8Array] | ["i64", Uint8Array];

function readVarint(buf: Uint8Array, index: number): [number, number] {
  let shift = 0;
  let value = 0;
  for (;;) {
    const byte = buf[index]!;
    index += 1;
    // Multiplication instead of << keeps values beyond 32 bits exact.
    value += (byte & 0x7f) * 2 ** shift;
    shift += 7;
    if ((byte & 0x80) === 0) return [value, index];
  }
}

function parseProtobuf(buf: Uint8Array): Map<number, PbValue[]> {
  // Decode an unlabeled protobuf message into {field number: [(wire, value)]}.
  // agy stores usage as unlabeled protobuf, so the field numbers come from
  // the reverse-engineered agent-walker map and every row is self-verified
  // before its numbers are trusted.
  const fields = new Map<number, PbValue[]>();
  let index = 0;
  while (index < buf.length) {
    let key: number;
    [key, index] = readVarint(buf, index);
    const field = key >>> 3;
    const wire = key & 7;
    const entries = fields.get(field) ?? [];
    if (wire === 0) {
      let value: number;
      [value, index] = readVarint(buf, index);
      entries.push(["varint", value]);
    } else if (wire === 2) {
      let size: number;
      [size, index] = readVarint(buf, index);
      entries.push(["bytes", buf.subarray(index, index + size)]);
      index += size;
    } else if (wire === 5) {
      entries.push(["i32", buf.subarray(index, index + 4)]);
      index += 4;
    } else if (wire === 1) {
      entries.push(["i64", buf.subarray(index, index + 8)]);
      index += 8;
    } else {
      throw new Error(`unsupported protobuf wire type ${wire}`);
    }
    fields.set(field, entries);
  }
  return fields;
}

function pbVarintValue(fields: Map<number, PbValue[]>, field: number): number {
  for (const [wire, value] of fields.get(field) ?? []) {
    if (wire === "varint") return value as number;
  }
  return 0;
}

function pbSubmessage(fields: Map<number, PbValue[]> | undefined, field: number): Map<number, PbValue[]> | null {
  if (!fields) return null;
  for (const [wire, value] of fields.get(field) ?? []) {
    if (wire === "bytes") {
      try {
        return parseProtobuf(value as Uint8Array);
      } catch {
        return null;
      }
    }
  }
  return null;
}

function pbString(fields: Map<number, PbValue[]>, field: number): string | null {
  for (const [wire, value] of fields.get(field) ?? []) {
    if (wire === "bytes") {
      return new TextDecoder().decode(value as Uint8Array);
    }
  }
  return null;
}

async function blobToBytes(value: unknown): Promise<Uint8Array> {
  if (value instanceof Blob) return new Uint8Array(await value.arrayBuffer());
  if (value instanceof Uint8Array) return value;
  throw new Error(`unexpected blob column type: ${typeof value}`);
}

async function probeAgy(stage: Stage, sessionId: string): Promise<UsageRecord> {
  const dbPath = path.join(agyConversationsDir(), `${sessionId}.db`);
  if (!existsSync(dbPath)) {
    return unavailableRecord(stage, "agy", sessionId, `no agy conversation database at ${dbPath}`);
  }
  let db: Database;
  try {
    db = openSqliteReadonly(dbPath);
  } catch (error) {
    return unavailableRecord(stage, "agy", sessionId, `agy database unreadable: ${errorMessage(error)}`);
  }
  let blobs: unknown[] = [];
  try {
    blobs = db.prepare("SELECT data FROM gen_metadata ORDER BY idx").values().flat();
  } catch (error) {
    return unavailableRecord(stage, "agy", sessionId, `agy database unreadable: ${errorMessage(error)}`);
  } finally {
    db.close();
  }

  const tokens = emptyTokens();
  const models: string[] = [];
  let verified = 0;
  let dropped = 0;
  for (const blob of blobs) {
    let buf: Uint8Array;
    try {
      buf = await blobToBytes(blob);
    } catch {
      dropped += 1;
      continue;
    }
    let outer: Map<number, PbValue[]>;
    try {
      outer = parseProtobuf(buf);
    } catch {
      dropped += 1;
      continue;
    }
    const envelope = pbSubmessage(outer, 1);
    const usage = envelope ? pbSubmessage(envelope, 4) : null;
    if (!usage) {
      dropped += 1;
      continue;
    }
    const storedTotal = pbVarintValue(usage, 3);
    const output = pbVarintValue(usage, 9);
    const thinking = pbVarintValue(usage, 10);
    // Self-check from agent-walker: a row whose stored total disagrees with
    // output + thinking has drifted from the reverse-engineered field map.
    if (storedTotal !== output + thinking) {
      dropped += 1;
      continue;
    }
    verified += 1;
    tokens.input += pbVarintValue(usage, 2);
    tokens.cache_read += pbVarintValue(usage, 5);
    tokens.output += output + thinking;
    tokens.reasoning += thinking;
    const model = pbString(envelope!, 19) ?? pbString(envelope!, 21);
    if (model && !models.includes(model)) models.push(model);
  }

  if (verified === 0) {
    return unavailableRecord(
      stage,
      "agy",
      sessionId,
      `no gen_metadata row passed the stored-total self-check (${dropped} dropped)`,
    );
  }

  const record = makeRecord(stage, "agy", sessionId, "builtin-agy", tokens, models, []);
  record.verified_rows = verified;
  record.dropped_rows = dropped;
  return record;
}

function claudeProjectsDir(): string {
  return process.env.AGENT_USAGE_AUDIT_CLAUDE_PROJECTS_DIR
    ?? path.join(homedir(), ".claude", "projects");
}

function findClaudeTranscript(sessionId: string): string | null {
  // Claude Code files transcripts under a per-working-directory slug, so the
  // session id is searched for across every project directory.
  const dir = claudeProjectsDir();
  if (!existsSync(dir)) return null;
  const matches = [...new Bun.Glob(`*/${sessionId}.jsonl`).scanSync({ cwd: dir, onlyFiles: true })].sort();
  return matches.length ? path.join(dir, matches[0]!) : null;
}

interface ClaudeUsage {
  input_tokens?: number;
  output_tokens?: number;
  cache_read_input_tokens?: number;
  cache_creation_input_tokens?: number;
  output_tokens_details?: { thinking_tokens?: number };
}

function addClaudeUsage(tokens: Tokens, usage: ClaudeUsage | undefined): void {
  tokens.input += usage?.input_tokens ?? 0;
  tokens.output += usage?.output_tokens ?? 0;
  tokens.cache_read += usage?.cache_read_input_tokens ?? 0;
  tokens.cache_write += usage?.cache_creation_input_tokens ?? 0;
  tokens.reasoning += usage?.output_tokens_details?.thinking_tokens ?? 0;
}

function probeClaudeCode(stage: Stage, sessionId: string): UsageRecord {
  const transcriptPath = findClaudeTranscript(sessionId);
  if (!transcriptPath) {
    return unavailableRecord(
      stage,
      "claude-code",
      sessionId,
      `no transcript found for session ${sessionId} under ${claudeProjectsDir()}`,
    );
  }

  const mainTokens = emptyTokens();
  const childTokens = emptyTokens();
  const mainModels: string[] = [];
  const childModels: string[] = [];
  // Streaming appends the same assistant message repeatedly; the
  // (message id, request id) pair is what makes a turn unique.
  const seen = new Set<string>();

  const lines = readFileSync(transcriptPath, "utf8").split("\n");
  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    let entry: any;
    try {
      entry = JSON.parse(trimmed);
    } catch {
      continue;
    }
    if (entry?.type !== "assistant") continue;
    const message = entry.message ?? {};
    const key = JSON.stringify([message.id ?? null, entry.requestId ?? null]);
    if (seen.has(key)) continue;
    seen.add(key);

    const sidechain = Boolean(entry.isSidechain);
    const tokens = sidechain ? childTokens : mainTokens;
    const models = sidechain ? childModels : mainModels;
    addClaudeUsage(tokens, message.usage);
    if (message.model && !models.includes(message.model)) models.push(message.model);
  }

  const children: ChildRecord[] = [];
  if (TOKEN_KEYS.some((key) => childTokens[key] !== 0)) {
    children.push({
      session_id: `${sessionId}#subagents`,
      harness: "claude-code",
      models: [...new Set(childModels)].sort(),
      tokens: finalizeTokens({ ...childTokens }),
    });
  }

  const rolledUp = emptyTokens();
  for (const key of TOKEN_KEYS) rolledUp[key] = mainTokens[key] + childTokens[key];

  return makeRecord(
    stage,
    "claude-code",
    sessionId,
    "builtin-claude-code",
    rolledUp,
    [...mainModels, ...childModels],
    children,
  );
}

async function probe(stage: Stage, sessionId?: string): Promise<UsageRecord> {
  const harness = detectHarness();
  const resolved = sessionId || detectSessionId(harness);
  if (!resolved) {
    return unavailableRecord(stage, harness, null, `no session id available for harness '${harness}'`);
  }
  if (harness === "claude-code") {
    return probeClaudeCode(stage, resolved);
  }
  if (harness === "opencode") {
    return probeOpencode(stage, resolved);
  }
  if (harness === "agy") {
    return await probeAgy(stage, resolved);
  }
  return unavailableRecord(stage, harness, resolved, `no usage adapter for harness '${harness}'`);
}

function parseArgs(argv: string[]): { command: string; stage?: string; session?: string } {
  const [command = "", ...rest] = argv;
  const parsed: { command: string; stage?: string; session?: string } = { command };
  for (let i = 0; i < rest.length; i++) {
    if (rest[i] === "--stage") parsed.stage = rest[i + 1];
    else if (rest[i] === "--session") parsed.session = rest[i + 1];
    else throw new Error(`unexpected argument: ${rest[i]}`);
    i += 1;
  }
  return parsed;
}

async function main(argv: string[]): Promise<number> {
  let args;
  try {
    args = parseArgs(argv);
  } catch (error) {
    console.error(error instanceof Error ? error.message : String(error));
    return 2;
  }
  if (args.command !== "probe" || !args.stage) {
    console.error("usage: agent-usage-audit probe --stage <stage> [--session <id>]");
    return 2;
  }
  if (!STAGES.includes(args.stage as Stage)) {
    console.error(`--stage must be one of: ${STAGES.join(", ")}`);
    return 2;
  }
  const record = await probe(args.stage as Stage, args.session);
  console.log(JSON.stringify(record, null, 2));
  return 0;
}

process.exit(await main(process.argv.slice(2)));
