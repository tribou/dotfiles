#!/usr/bin/env bun
/**
 * Probe the running agent harness for this session's model and token usage
 * and emit one normalized JSON audit record on stdout.
 *
 * Subcommands:
 *   probe --stage STAGE [--session ID]   emit one normalized JSON record
 *   record --stage STAGE --target issue:N|pr:M [--session ID] [--dry-run] [--record FILE]
 *                                       upsert the audit comment on a GitHub issue/PR
 *   merge --existing FILE --record FILE  merge a record into a ledger by (session_id, stage),
 *                                       stable stage/timestamp ordering
 *   render [--file FILE]                 render ledger records as the audit comment
 *                                       (markdown table + collapsed JSON details)
 *   parse [--file FILE]                  extract ledger records from an audit comment body
 *
 * Nothing here ever guesses a number: a probe that cannot read real usage
 * emits a record with "source": "unavailable" and a human-readable reason.
 */
import { Database } from "bun:sqlite";
import { existsSync, readFileSync, unlinkSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";

const SCHEMA = 1;
const PREFERRED_STAGES = ["brainstorming-to-issue", "issue-to-plan", "plan-to-implementation"] as const;
const STAGE_PATTERN = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
type Stage = string;

type Harness = "claude-code" | "opencode" | "agy" | "unknown";
type Role = "orchestrator" | "subagent";

const TOKEN_KEYS = ["input", "output", "cache_read", "cache_write", "reasoning"] as const;
type TokenKey = (typeof TOKEN_KEYS)[number];

interface Tokens {
  input: number;
  output: number;
  cache_read: number;
  cache_write: number;
  reasoning: number;
  total: number;
}

interface ChildRecord {
  session_id: string;
  harness: Harness;
  models: string[];
  tokens: Tokens;
}

interface ModelBreakdown {
  role?: Role;
  model: string;
  tokens: Tokens;
  cost_usd?: number | null;
}

interface UsageRecord {
  schema: number;
  stage: Stage;
  harness: Harness;
  session_id: string;
  source: string;
  models: string[];
  model_breakdowns: ModelBreakdown[];
  tokens: Tokens;
  cost_usd: number | null;
  children: ChildRecord[];
  updated_at: string;
  reason?: string;
  verified_rows?: number;
  dropped_rows?: number;
}

interface LedgerEnvelope {
  schema: number;
  records: UsageRecord[];
}

function sortRecords(records: UsageRecord[]): UsageRecord[] {
  return [...records].sort((a, b) => {
    const stageIdxA = PREFERRED_STAGES.indexOf(a.stage as (typeof PREFERRED_STAGES)[number]);
    const stageIdxB = PREFERRED_STAGES.indexOf(b.stage as (typeof PREFERRED_STAGES)[number]);
    if (stageIdxA !== stageIdxB) {
      if (stageIdxA === -1) return 1;
      if (stageIdxB === -1) return -1;
      return stageIdxA - stageIdxB;
    }
    if (stageIdxA === -1) {
      const stageCompare = (a.stage || "").localeCompare(b.stage || "");
      if (stageCompare !== 0) return stageCompare;
    }
    const timeCompare = (a.updated_at || "").localeCompare(b.updated_at || "");
    if (timeCompare !== 0) return timeCompare;
    return (a.session_id || "").localeCompare(b.session_id || "");
  });
}

function isStage(value: string): boolean {
  return STAGE_PATTERN.test(value);
}

function mergeLedger(existingRecords: UsageRecord[], newRecord: UsageRecord): UsageRecord[] {
  const records = [...existingRecords];
  const idx = records.findIndex((r) => r.session_id === newRecord.session_id && r.stage === newRecord.stage);
  if (idx >= 0) {
    records[idx] = newRecord;
  } else {
    records.push(newRecord);
  }
  return sortRecords(records);
}

function emptyTokens(): Tokens {
  return { input: 0, output: 0, cache_read: 0, cache_write: 0, reasoning: 0, total: 0 };
}

function finalizeTokens(tokens: Tokens): Tokens {
  // Reasoning is a subset of output, never re-added.
  tokens.total = tokens.input + tokens.output + tokens.cache_read + tokens.cache_write;
  return tokens;
}

function utcNow(): string {
  return new Date().toISOString().replace(/\.\d+Z$/, "Z");
}

function detectHarness(): Harness {
  const forced: unknown = process.env.AGENT_USAGE_AUDIT_HARNESS;
  if (isHarness(forced)) return forced;
  if (process.env.OPENCODE || process.env.OPENCODE_SESSION_ID) return "opencode";
  if (process.env.CLAUDECODE || process.env.CLAUDE_CODE_SESSION_ID || process.env.CLAUDE_SESSION_ID) return "claude-code";
  if (process.env.AGY_CONVERSATION_ID || process.env.ANTIGRAVITY_CONVERSATION_ID || process.env.ANTIGRAVITY_AGENT) return "agy";
  return "unknown";
}

function isHarness(value: unknown): value is Harness {
  return value === "claude-code" || value === "opencode" || value === "agy" || value === "unknown";
}

function detectSessionId(harness: Harness): string | null {
  const forced = process.env.AGENT_USAGE_AUDIT_SESSION_ID;
  if (forced) return forced;
  if (harness === "claude-code") {
    return process.env.CLAUDE_CODE_SESSION_ID ?? process.env.CLAUDE_SESSION_ID ?? null;
  }
  if (harness === "opencode") return process.env.OPENCODE_SESSION_ID ?? null;
  if (harness === "agy") {
    return process.env.AGY_CONVERSATION_ID ?? process.env.ANTIGRAVITY_CONVERSATION_ID ?? null;
  }
  return null;
}

function makeRecord(
  stage: Stage,
  harness: Harness,
  sessionId: string | null,
  source: string,
  tokens: Tokens,
  models: string[],
  children: ChildRecord[],
  options: { costUsd?: number | null; reason?: string; modelBreakdowns?: ModelBreakdown[] } = {},
): UsageRecord {
  const uniqueModels = [...new Set(models)].sort();
  const modelBreakdowns = options.modelBreakdowns ?? (
    uniqueModels.length === 1
      ? [{ model: uniqueModels[0]!, tokens: finalizeTokens(tokens), cost_usd: options.costUsd ?? null }]
      : []
  );
  const record: UsageRecord = {
    schema: SCHEMA,
    stage,
    harness,
    session_id: sessionId ?? "unknown",
    source,
    models: uniqueModels,
    model_breakdowns: modelBreakdowns,
    tokens: finalizeTokens(tokens),
    cost_usd: options.costUsd ?? null,
    children,
    updated_at: utcNow(),
  };
  if (options.reason) record.reason = options.reason;
  return record;
}

function unavailableRecord(
  stage: Stage,
  harness: Harness,
  sessionId: string | null,
  reason: string,
): UsageRecord {
  return makeRecord(stage, harness, sessionId, "unavailable", emptyTokens(), [], [], { reason });
}

function openSqliteReadonly(dbPath: string): Database {
  // Read-only so a live agent session is never disturbed.
  return new Database(dbPath, { readonly: true });
}

function errorMessage(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}

const OPENCODE_COLUMNS =
  "id, parent_id, model, cost, tokens_input, tokens_output, tokens_reasoning," +
  " tokens_cache_read, tokens_cache_write";

interface OpencodeRow {
  id: string;
  parent_id: string | null;
  model: string | null;
  cost: number | null;
  tokens_input: number | null;
  tokens_output: number | null;
  tokens_reasoning: number | null;
  tokens_cache_read: number | null;
  tokens_cache_write: number | null;
}

function normalizeModelName(raw: string | null): string | null {
  if (!raw) return null;
  try {
    const parsed = JSON.parse(raw);
    if (parsed && typeof parsed === "object" && typeof parsed.id === "string") return parsed.id;
  } catch {}
  return raw;
}

function opencodeRowTokens(row: OpencodeRow): Tokens {
  const tokens = emptyTokens();
  tokens.input = row.tokens_input ?? 0;
  // opencode keeps reasoning in its own column; the normalized `output` is the
  // billed output including reasoning, and `reasoning` repeats the subset.
  tokens.output = (row.tokens_output ?? 0) + (row.tokens_reasoning ?? 0);
  tokens.reasoning = row.tokens_reasoning ?? 0;
  tokens.cache_read = row.tokens_cache_read ?? 0;
  tokens.cache_write = row.tokens_cache_write ?? 0;
  return finalizeTokens(tokens);
}

function opencodeDbPath(): string {
  return process.env.AGENT_USAGE_AUDIT_OPENCODE_DB
    ?? path.join(homedir(), ".local", "share", "opencode", "opencode.db");
}

function probeOpencode(stage: Stage, sessionId: string): UsageRecord {
  const dbPath = opencodeDbPath();
  if (!existsSync(dbPath)) {
    return unavailableRecord(stage, "opencode", sessionId, `opencode.db not found at ${dbPath}`);
  }
  let db: Database;
  try {
    db = openSqliteReadonly(dbPath);
  } catch (error) {
    return unavailableRecord(stage, "opencode", sessionId, `opencode.db unreadable: ${errorMessage(error)}`);
  }
  let parent: OpencodeRow | null = null;
  let rows: OpencodeRow[] = [];
  try {
    rows = db.prepare(`SELECT ${OPENCODE_COLUMNS} FROM session`).all() as OpencodeRow[];
    parent = rows.find((row) => row.id === sessionId) ?? null;
  } catch (error) {
    return unavailableRecord(stage, "opencode", sessionId, `opencode.db unreadable: ${errorMessage(error)}`);
  } finally {
    db.close();
  }

  if (!parent) {
    return unavailableRecord(stage, "opencode", sessionId, `session ${sessionId} not present in ${dbPath}`);
  }

  const breakdowns = new Map<string, { role: Role; model: string; tokens: Tokens; cost: number | null }>();
  function recordModelUsage(role: Role, model: string, rowTokens: Tokens, rowCost: number | null) {
    const key = JSON.stringify([role, model]);
    let entry = breakdowns.get(key);
    if (!entry) {
      entry = { role, model, tokens: emptyTokens(), cost: null };
      breakdowns.set(key, entry);
    }
    for (const k of TOKEN_KEYS) entry.tokens[k] += rowTokens[k];
    if (rowCost !== null) entry.cost = (entry.cost ?? 0) + rowCost;
  }

  const parentModel = normalizeModelName(parent.model) ?? "unknown";
  recordModelUsage("orchestrator", parentModel, opencodeRowTokens(parent), parent.cost);

  const rolledUp = opencodeRowTokens(parent);
  const models: string[] = parent.model ? [parentModel] : [];
  let cost = parent.cost;
  const childrenByParent = new Map<string, OpencodeRow[]>();
  for (const row of rows) {
    if (row.parent_id === null) continue;
    const children = childrenByParent.get(row.parent_id) ?? [];
    children.push(row);
    childrenByParent.set(row.parent_id, children);
  }

  // Walk the complete descendant graph while preventing parent_id cycles from
  // re-adding a session indefinitely.
  const descendants: OpencodeRow[] = [];
  const visited = new Set([sessionId]);
  const pending = [...(childrenByParent.get(sessionId) ?? [])];
  while (pending.length > 0) {
    const child = pending.shift()!;
    if (visited.has(child.id)) continue;
    visited.add(child.id);
    descendants.push(child);
    pending.push(...(childrenByParent.get(child.id) ?? []));
  }

  const children: ChildRecord[] = [];
  for (const kid of descendants) {
    const kidTokens = opencodeRowTokens(kid);
    const kidModel = normalizeModelName(kid.model) ?? "unknown";
    recordModelUsage("subagent", kidModel, kidTokens, kid.cost);
    if (kid.cost !== null) cost = (cost ?? 0) + kid.cost;
    if (kid.model) models.push(kidModel);
    for (const key of TOKEN_KEYS) rolledUp[key] += kidTokens[key];
    children.push({
      session_id: kid.id,
      harness: "opencode",
      models: kid.model ? [kidModel] : [],
      tokens: kidTokens,
    });
  }

  const modelBreakdowns: ModelBreakdown[] = [...breakdowns.values()]
    .sort((a, b) => a.model.localeCompare(b.model) || a.role.localeCompare(b.role))
    .map((entry) => ({
      role: entry.role,
      model: entry.model,
      tokens: finalizeTokens(entry.tokens),
      cost_usd: entry.cost === null ? null : Math.round(entry.cost * 1e6) / 1e6,
    }));

  // Rounding keeps 0.42 + 0.08 from printing as 0.5000000000000001.
  const costUsd = cost === null ? null : Math.round(cost * 1e6) / 1e6;
  return makeRecord(stage, "opencode", sessionId, "builtin-opencode", rolledUp, models, children, { costUsd, modelBreakdowns });
}

function agyConversationsDir(): string {
  return process.env.AGENT_USAGE_AUDIT_AGY_DIR
    ?? path.join(homedir(), ".gemini", "antigravity-cli", "conversations");
}

type PbValue = ["varint", number] | ["bytes", Uint8Array] | ["i32", Uint8Array] | ["i64", Uint8Array];

function readVarint(buf: Uint8Array, index: number): [number, number] {
  let shift = 0;
  let value = 0;
  for (let count = 0; count < 10; count += 1) {
    if (index >= buf.length) throw new Error("truncated protobuf varint");
    const byte = buf[index]!;
    index += 1;
    // Multiplication instead of << keeps values beyond 32 bits exact.
    value += (byte & 0x7f) * 2 ** shift;
    if (!Number.isSafeInteger(value)) throw new Error("protobuf varint exceeds safe integer range");
    shift += 7;
    if ((byte & 0x80) === 0) return [value, index];
  }
  throw new Error("protobuf varint is too long");
}

function parseProtobuf(buf: Uint8Array): Map<number, PbValue[]> {
  // Decode an unlabeled protobuf message into {field number: [(wire, value)]}.
  // agy stores usage as unlabeled protobuf, so the field numbers come from
  // the reverse-engineered agent-walker map and every row is self-verified
  // before its numbers are trusted.
  const fields = new Map<number, PbValue[]>();
  let index = 0;
  while (index < buf.length) {
    let key: number;
    [key, index] = readVarint(buf, index);
    const field = Math.floor(key / 8);
    const wire = key & 7;
    const entries = fields.get(field) ?? [];
    if (wire === 0) {
      let value: number;
      [value, index] = readVarint(buf, index);
      entries.push(["varint", value]);
    } else if (wire === 2) {
      let size: number;
      [size, index] = readVarint(buf, index);
      if (size > buf.length - index) throw new Error("truncated protobuf length-delimited field");
      entries.push(["bytes", buf.subarray(index, index + size)]);
      index += size;
    } else if (wire === 5) {
      if (buf.length - index < 4) throw new Error("truncated protobuf 32-bit field");
      entries.push(["i32", buf.subarray(index, index + 4)]);
      index += 4;
    } else if (wire === 1) {
      if (buf.length - index < 8) throw new Error("truncated protobuf 64-bit field");
      entries.push(["i64", buf.subarray(index, index + 8)]);
      index += 8;
    } else {
      throw new Error(`unsupported protobuf wire type ${wire}`);
    }
    fields.set(field, entries);
  }
  return fields;
}

function pbVarintValue(fields: Map<number, PbValue[]>, field: number): number | null {
  for (const [wire, value] of fields.get(field) ?? []) {
    if (wire === "varint") return value as number;
  }
  return null;
}

function pbSubmessage(fields: Map<number, PbValue[]> | undefined, field: number): Map<number, PbValue[]> | null {
  if (!fields) return null;
  for (const [wire, value] of fields.get(field) ?? []) {
    if (wire === "bytes") {
      try {
        return parseProtobuf(value as Uint8Array);
      } catch {
        return null;
      }
    }
  }
  return null;
}

function pbString(fields: Map<number, PbValue[]>, field: number): string | null {
  for (const [wire, value] of fields.get(field) ?? []) {
    if (wire === "bytes") {
      return new TextDecoder().decode(value as Uint8Array);
    }
  }
  return null;
}

async function blobToBytes(value: unknown): Promise<Uint8Array> {
  if (value instanceof Blob) return new Uint8Array(await value.arrayBuffer());
  if (value instanceof Uint8Array) return value;
  throw new Error(`unexpected blob column type: ${typeof value}`);
}

async function probeAgy(stage: Stage, sessionId: string): Promise<UsageRecord> {
  const dbPath = path.join(agyConversationsDir(), `${sessionId}.db`);
  if (!existsSync(dbPath)) {
    return unavailableRecord(stage, "agy", sessionId, `no agy conversation database at ${dbPath}`);
  }
  let db: Database;
  try {
    db = openSqliteReadonly(dbPath);
  } catch (error) {
    return unavailableRecord(stage, "agy", sessionId, `agy database unreadable: ${errorMessage(error)}`);
  }
  let blobs: unknown[] = [];
  try {
    blobs = db.prepare("SELECT data FROM gen_metadata ORDER BY idx").values().flat();
  } catch (error) {
    return unavailableRecord(stage, "agy", sessionId, `agy database unreadable: ${errorMessage(error)}`);
  } finally {
    db.close();
  }

  const tokens = emptyTokens();
  const models: string[] = [];
  const tokensByModel = new Map<string, Tokens>();
  let verified = 0;
  let dropped = 0;
  for (const blob of blobs) {
    let buf: Uint8Array;
    try {
      buf = await blobToBytes(blob);
    } catch {
      dropped += 1;
      continue;
    }
    let outer: Map<number, PbValue[]>;
    try {
      outer = parseProtobuf(buf);
    } catch {
      dropped += 1;
      continue;
    }
    const envelope = pbSubmessage(outer, 1);
    const usage = envelope ? pbSubmessage(envelope, 4) : null;
    if (!usage) {
      dropped += 1;
      continue;
    }
    const storedTotal = pbVarintValue(usage, 3);
    const output = pbVarintValue(usage, 9);
    const thinking = pbVarintValue(usage, 10);
    if (storedTotal === null || output === null || thinking === null) {
      dropped += 1;
      continue;
    }
    // Self-check from agent-walker: a row whose stored total disagrees with
    // output + thinking has drifted from the reverse-engineered field map.
    if (storedTotal !== output + thinking) {
      dropped += 1;
      continue;
    }
    verified += 1;
    tokens.input += pbVarintValue(usage, 2) ?? 0;
    tokens.cache_read += pbVarintValue(usage, 5) ?? 0;
    tokens.output += output + thinking;
    tokens.reasoning += thinking;
    const model = pbString(envelope!, 19) ?? pbString(envelope!, 21);
    if (model && !models.includes(model)) models.push(model);

    const m = model ?? "unknown";
    if (!tokensByModel.has(m)) tokensByModel.set(m, emptyTokens());
    const mt = tokensByModel.get(m)!;
    mt.input += pbVarintValue(usage, 2) ?? 0;
    mt.cache_read += pbVarintValue(usage, 5) ?? 0;
    mt.output += output + thinking;
    mt.reasoning += thinking;
  }

  if (verified === 0) {
    return unavailableRecord(
      stage,
      "agy",
      sessionId,
      `no gen_metadata row passed the stored-total self-check (${dropped} dropped)`,
    );
  }

  const modelBreakdowns: ModelBreakdown[] = [...tokensByModel.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([model, tok]) => ({ role: "orchestrator", model, tokens: finalizeTokens(tok) }));

  const record = makeRecord(stage, "agy", sessionId, "builtin-agy", tokens, models, [], { modelBreakdowns });
  record.verified_rows = verified;
  record.dropped_rows = dropped;
  return record;
}

const CCUSAGE_TIMEOUT_MS = 30_000;

interface CcusageModelBreakdown {
  modelName?: string;
  inputTokens?: number;
  outputTokens?: number;
  cacheReadTokens?: number;
  cacheCreationTokens?: number;
  cost?: number | null;
}

interface CcusageEntry {
  sessionId?: string;
  inputTokens?: number;
  outputTokens?: number;
  cacheReadTokens?: number;
  cacheCreationTokens?: number;
  reasoningTokens?: number;
  totalCost?: number | null;
  modelsUsed?: string[];
  children?: CcusageEntry[];
  modelBreakdowns?: CcusageModelBreakdown[];
}

function isCcusageObject(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function isCcusageToken(value: unknown): boolean {
  return typeof value === "number" && Number.isFinite(value) && value >= 0;
}

function isCcusageCost(value: unknown): boolean {
  return value === null || isCcusageToken(value);
}

function validatedCcusageEntry(value: unknown): CcusageEntry | null {
  if (!isCcusageObject(value)) return null;
  if (typeof value.sessionId !== "string" || value.sessionId.trim().length === 0) return null;
  for (const key of [
    "inputTokens",
    "outputTokens",
    "cacheReadTokens",
    "cacheCreationTokens",
  ]) {
    if (!Object.prototype.hasOwnProperty.call(value, key) || !isCcusageToken(value[key])) return null;
  }
  if (value.reasoningTokens !== undefined && !isCcusageToken(value.reasoningTokens)) {
    return null;
  }
  if (value.totalCost !== undefined && !isCcusageCost(value.totalCost)) return null;
  if (
    value.modelsUsed !== undefined
    && (!Array.isArray(value.modelsUsed) || !value.modelsUsed.every((model) => typeof model === "string"))
  ) {
    return null;
  }
  if (value.modelBreakdowns !== undefined) {
    if (Array.isArray(value.modelBreakdowns)) {
      for (const item of value.modelBreakdowns) {
        if (!isCcusageObject(item)) return null;
      }
    } else if (!isCcusageObject(value.modelBreakdowns)) {
      return null;
    }
  }
  if (value.children !== undefined) {
    if (!Array.isArray(value.children)) return null;
    for (const child of value.children) {
      if (!validatedCcusageEntry(child)) return null;
    }
  }
  return value as CcusageEntry;
}

function ccusageEntry(payload: unknown, sessionId: string): CcusageEntry | null {
  if (!isCcusageObject(payload)) return null;
  if (Object.prototype.hasOwnProperty.call(payload, "sessions")) {
    if (!Array.isArray(payload.sessions)) return null;
    let matchingEntry: CcusageEntry | null = null;
    for (const candidate of payload.sessions) {
      const entry = validatedCcusageEntry(candidate);
      if (!entry) return null;
      if (entry.sessionId === sessionId) matchingEntry = entry;
    }
    return matchingEntry;
  }
  const entry = validatedCcusageEntry(payload);
  return entry?.sessionId === sessionId ? entry : null;
}

function ccusageTokensFrom(entry: CcusageEntry): Tokens {
  const tokens = emptyTokens();
  tokens.input = entry.inputTokens ?? 0;
  tokens.output = entry.outputTokens ?? 0;
  tokens.cache_read = entry.cacheReadTokens ?? 0;
  tokens.cache_write = entry.cacheCreationTokens ?? 0;
  tokens.reasoning = entry.reasoningTokens ?? 0;
  return tokens;
}

function probeCcusage(stage: Stage, harness: Harness, sessionId: string): UsageRecord | null {
  // Preferred source: ccusage already handles dedup and cache-bucket pricing
  // across harnesses. Any doubt returns null so the built-in adapters run.
  if (process.env.AGENT_USAGE_AUDIT_DISABLE_CCUSAGE) return null;
  const executable = Bun.which("ccusage");
  if (!executable) return null;
  let completed: ReturnType<typeof Bun.spawnSync>;
  try {
    completed = Bun.spawnSync([executable, "session", "--id", sessionId, "--json"], {
      stdout: "pipe",
      stderr: "pipe",
      timeout: CCUSAGE_TIMEOUT_MS,
    });
  } catch {
    return null;
  }
  if (completed.exitCode !== 0) return null;
  const stdout = completed.stdout?.toString() ?? "";
  if (!stdout.trim()) return null;
  let payload: unknown;
  try {
    payload = JSON.parse(stdout);
  } catch {
    return null;
  }
  const entry = ccusageEntry(payload, sessionId);
  if (!entry) return null;

  const children: ChildRecord[] = [];
  for (const child of entry.children ?? []) {
    if (!child || typeof child !== "object") continue;
    children.push({
      session_id: child.sessionId ?? "unknown",
      harness,
      models: child.modelsUsed ?? [],
      tokens: finalizeTokens(ccusageTokensFrom(child)),
    });
  }

  const modelBreakdowns: ModelBreakdown[] = [];
  // ccusage aggregates main and sidechain turns by model, so assigning an
  // execution role here would fabricate provenance.
  const rawBreakdowns = Array.isArray((entry as any).modelBreakdowns)
    ? (entry as any).modelBreakdowns
    : isCcusageObject((entry as any).modelBreakdowns)
      ? Object.values((entry as any).modelBreakdowns)
      : [];
  for (const b of rawBreakdowns) {
    if (!b || typeof b !== "object") continue;
    const t = emptyTokens();
    t.input = b.inputTokens ?? 0;
    t.output = b.outputTokens ?? 0;
    t.cache_read = b.cacheReadTokens ?? 0;
    t.cache_write = b.cacheCreationTokens ?? 0;
    modelBreakdowns.push({
      model: b.modelName ?? "unknown",
      tokens: finalizeTokens(t),
      cost_usd: b.cost ?? null,
    });
  }
  if (modelBreakdowns.length === 0 && entry.modelsUsed && entry.modelsUsed.length === 1) {
    modelBreakdowns.push({
      model: entry.modelsUsed[0]!,
      tokens: finalizeTokens(ccusageTokensFrom(entry)),
      cost_usd: entry.totalCost ?? null,
    });
  }

  return makeRecord(stage, harness, sessionId, "ccusage", ccusageTokensFrom(entry), entry.modelsUsed ?? [], children, {
    costUsd: entry.totalCost ?? null,
    modelBreakdowns,
  });
}

function claudeProjectsDir(): string {
  return process.env.AGENT_USAGE_AUDIT_CLAUDE_PROJECTS_DIR
    ?? path.join(homedir(), ".claude", "projects");
}

function findClaudeTranscript(sessionId: string): string | null {
  // Claude Code files transcripts under a per-working-directory slug, so the
  // session id is searched for across every project directory.
  const dir = claudeProjectsDir();
  if (!existsSync(dir)) return null;
  const matches = [...new Bun.Glob(`*/${sessionId}.jsonl`).scanSync({ cwd: dir, onlyFiles: true })].sort();
  return matches.length ? path.join(dir, matches[0]!) : null;
}

interface ClaudeUsage {
  input_tokens?: number;
  output_tokens?: number;
  cache_read_input_tokens?: number;
  cache_creation_input_tokens?: number;
  output_tokens_details?: { thinking_tokens?: number };
}

function validClaudeNumber(value: unknown): value is number {
  return typeof value === "number" && Number.isFinite(value) && value >= 0;
}

function validatedClaudeUsage(value: unknown): ClaudeUsage | null {
  if (value === null || typeof value !== "object" || Array.isArray(value)) return null;
  const usage = value as Record<string, unknown>;
  let hasUsageField = false;
  for (const key of [
    "input_tokens",
    "output_tokens",
    "cache_read_input_tokens",
    "cache_creation_input_tokens",
  ]) {
    if (usage[key] !== undefined) {
      if (!validClaudeNumber(usage[key])) return null;
      hasUsageField = true;
    }
  }
  if (usage.output_tokens_details !== undefined) {
    const details = usage.output_tokens_details;
    if (details === null || typeof details !== "object" || Array.isArray(details)) return null;
    const thinking = (details as Record<string, unknown>).thinking_tokens;
    if (thinking !== undefined && !validClaudeNumber(thinking)) return null;
    hasUsageField ||= thinking !== undefined;
  }
  return hasUsageField ? usage as ClaudeUsage : null;
}

function addClaudeUsage(tokens: Tokens, usage: ClaudeUsage): void {
  tokens.input += usage?.input_tokens ?? 0;
  tokens.output += usage?.output_tokens ?? 0;
  tokens.cache_read += usage?.cache_read_input_tokens ?? 0;
  tokens.cache_write += usage?.cache_creation_input_tokens ?? 0;
  tokens.reasoning += usage?.output_tokens_details?.thinking_tokens ?? 0;
}

function probeClaudeCode(stage: Stage, sessionId: string): UsageRecord {
  const transcriptPath = findClaudeTranscript(sessionId);
  if (!transcriptPath) {
    return unavailableRecord(
      stage,
      "claude-code",
      sessionId,
      `no transcript found for session ${sessionId} under ${claudeProjectsDir()}`,
    );
  }

  const mainTokens = emptyTokens();
  const childTokens = emptyTokens();
  const mainModels: string[] = [];
  const childModels: string[] = [];
  const breakdowns = new Map<string, { role: Role; model: string; tokens: Tokens }>();
  // Streaming appends the same assistant message repeatedly; the
  // (message id, request id) pair is what makes a turn unique.
  const seen = new Set<string>();

  let lines: string[];
  try {
    lines = readFileSync(transcriptPath, "utf8").split("\n");
  } catch (error) {
    return unavailableRecord(
      stage,
      "claude-code",
      sessionId,
      `transcript unreadable: ${error instanceof Error ? error.message : String(error)}`,
    );
  }

  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    let entry: any;
    try {
      entry = JSON.parse(trimmed);
    } catch {
      continue;
    }
    if (entry?.type !== "assistant") continue;
    const message = entry.message;
    if (message === null || typeof message !== "object" || Array.isArray(message)) continue;
    const usage = validatedClaudeUsage((message as Record<string, unknown>).usage);
    if (!usage) continue;
    const messageKey = JSON.stringify([message.id ?? null, entry.requestId ?? null]);
    if (seen.has(messageKey)) continue;
    seen.add(messageKey);

    const sidechain = Boolean(entry.isSidechain);
    const tokens = sidechain ? childTokens : mainTokens;
    const models = sidechain ? childModels : mainModels;
    addClaudeUsage(tokens, usage);
    if (message.model && !models.includes(message.model)) models.push(message.model);

    const m = (message as Record<string, unknown>).model;
    const model = typeof m === "string" ? m : "unknown";
    const role: Role = sidechain ? "subagent" : "orchestrator";
    const breakdownKey = JSON.stringify([role, model]);
    if (!breakdowns.has(breakdownKey)) breakdowns.set(breakdownKey, { role, model, tokens: emptyTokens() });
    addClaudeUsage(breakdowns.get(breakdownKey)!.tokens, usage);
  }

  if (seen.size === 0) {
    return unavailableRecord(
      stage,
      "claude-code",
      sessionId,
      `no assistant turns found in transcript ${transcriptPath}`,
    );
  }

  const children: ChildRecord[] = [];
  if (TOKEN_KEYS.some((key) => childTokens[key] !== 0)) {
    children.push({
      session_id: `${sessionId}#subagents`,
      harness: "claude-code",
      models: [...new Set(childModels)].sort(),
      tokens: finalizeTokens({ ...childTokens }),
    });
  }

  const rolledUp = emptyTokens();
  for (const key of TOKEN_KEYS) rolledUp[key] = mainTokens[key] + childTokens[key];

  const modelBreakdowns: ModelBreakdown[] = [...breakdowns.values()]
    .sort((a, b) => a.model.localeCompare(b.model) || a.role.localeCompare(b.role))
    .map(({ role, model, tokens }) => ({ role, model, tokens: finalizeTokens(tokens) }));

  return makeRecord(
    stage,
    "claude-code",
    sessionId,
    "builtin-claude-code",
    rolledUp,
    [...mainModels, ...childModels],
    children,
    { modelBreakdowns },
  );
}

async function probe(stage: Stage, sessionId?: string): Promise<UsageRecord> {
  const harness = detectHarness();
  const resolved = sessionId || detectSessionId(harness);
  if (!resolved) {
    return unavailableRecord(stage, harness, null, `no session id available for harness '${harness}'`);
  }
  const fromCcusage = probeCcusage(stage, harness, resolved);
  if (fromCcusage) return fromCcusage;
  if (harness === "claude-code") {
    return probeClaudeCode(stage, resolved);
  }
  if (harness === "opencode") {
    return probeOpencode(stage, resolved);
  }
  if (harness === "agy") {
    return await probeAgy(stage, resolved);
  }
  return unavailableRecord(stage, harness, resolved, `no usage adapter for harness '${harness}'`);
}

function formatTokenCount(n: number | null | undefined): string {
  if (n === null || n === undefined) return "0";
  return n.toLocaleString("en-US");
}

function renderAuditComment(records: UsageRecord[]): string {
  const lines: string[] = [
    "### 🤖 Agent usage",
    "",
    "<!-- BEGIN AGENT USAGE -->",
    "| Stage | Session | Harness | Role | Model | Input | Output | Cache Read | Cache Write | Total | Source |",
    "|---|---|---|---|---|---|---|---|---|---|---|",
  ];

  let totalInput = 0;
  let totalOutput = 0;
  let totalCacheRead = 0;
  let totalCacheWrite = 0;
  let totalTokens = 0;

  for (const record of records) {
    if (record.source === "unavailable") {
      const sess = record.session_id || "—";
      const harness = record.harness || "—";
      lines.push(`| ${record.stage} | ${sess} | ${harness} | — | — | — | — | — | — | — | ${record.source} |`);
      continue;
    }

    const breakdowns = record.model_breakdowns && record.model_breakdowns.length > 0
      ? record.model_breakdowns
      : [{ model: record.models.join(", ") || "—", tokens: record.tokens }];

    for (const mb of breakdowns) {
      const input = mb.tokens.input ?? 0;
      const output = mb.tokens.output ?? 0;
      const cacheRead = mb.tokens.cache_read ?? 0;
      const cacheWrite = mb.tokens.cache_write ?? 0;
      const total = mb.tokens.total ?? (input + output + cacheRead + cacheWrite);

      totalInput += input;
      totalOutput += output;
      totalCacheRead += cacheRead;
      totalCacheWrite += cacheWrite;
      totalTokens += total;

      lines.push(
        `| ${record.stage} | ${record.session_id} | ${record.harness} | ${mb.role ?? "—"} | ${mb.model} | ${formatTokenCount(input)} | ${formatTokenCount(output)} | ${formatTokenCount(cacheRead)} | ${formatTokenCount(cacheWrite)} | ${formatTokenCount(total)} | ${record.source} |`,
      );
    }
  }

  lines.push(
    `| **Total** | | | | | ${formatTokenCount(totalInput)} | ${formatTokenCount(totalOutput)} | ${formatTokenCount(totalCacheRead)} | ${formatTokenCount(totalCacheWrite)} | ${formatTokenCount(totalTokens)} | |`,
  );
  lines.push("");
  lines.push("<details>");
  lines.push("<summary>Ledger data</summary>");
  lines.push("");
  lines.push("```json");
  lines.push(JSON.stringify({ schema: SCHEMA, records }, null, 2));
  lines.push("```");
  lines.push("</details>");
  lines.push("<!-- END AGENT USAGE -->");

  return lines.join("\n");
}

function parseAuditComment(commentBody: string): UsageRecord[] {
  if (!commentBody || typeof commentBody !== "string") return [];
  const beginMarker = "<!-- BEGIN AGENT USAGE -->";
  const endMarker = "<!-- END AGENT USAGE -->";
  const beginIdx = commentBody.indexOf(beginMarker);
  const endIdx = commentBody.indexOf(endMarker);
  const content = (beginIdx >= 0 && endIdx > beginIdx)
    ? commentBody.slice(beginIdx + beginMarker.length, endIdx)
    : commentBody;

  const jsonMatch = content.match(/```json\s*([\s\S]*?)\s*```/);
  if (!jsonMatch || !jsonMatch[1]) return [];

  try {
    const parsed = JSON.parse(jsonMatch[1]);
    if (parsed && Array.isArray(parsed.records)) return parsed.records;
    if (Array.isArray(parsed)) return parsed;
    return [];
  } catch {
    return [];
  }
}

const GH_COMMENT_MAX_BYTES = 65536;

interface RecordOptions {
  stage: Stage;
  session?: string;
  target: string;
  dryRun?: boolean;
  recordFile?: string;
}

function parseTarget(target: string): number {
  const match = target.match(/^(?:issue:|pr:|#)?(\d+)$/i);
  if (!match) {
    throw new Error(`invalid --target '${target}': expected issue:<number> or pr:<number>`);
  }
  const n = parseInt(match[1]!, 10);
  if (isNaN(n) || n <= 0) throw new Error(`invalid issue/pr number in target '${target}'`);
  return n;
}

function runGh(args: string[]): string {
  const res = Bun.spawnSync(["gh", ...args], {
    env: process.env,
    stdout: "pipe",
    stderr: "pipe",
  });
  if (res.exitCode !== 0) {
    const err = Buffer.from(res.stderr).toString().trim();
    throw new Error(`gh ${args.join(" ")} failed (exit ${res.exitCode}): ${err}`);
  }
  return Buffer.from(res.stdout).toString();
}

function findAuditComment(targetNum: number, repo: string): { id: number; body: string } | null {
  const raw = runGh(["api", "--paginate", `repos/${repo}/issues/${targetNum}/comments`]);
  let comments: any[] = [];
  try {
    comments = JSON.parse(raw);
    if (!Array.isArray(comments)) comments = [];
  } catch {
    comments = [];
  }

  for (const c of comments) {
    if (typeof c.body === "string" && c.body.includes("<!-- BEGIN AGENT USAGE -->")) {
      // Plan comments quote their own markers; they are never the ledger.
      const planMarker = "<" + "!-- BEGIN PLAN --" + ">";
      if (!c.body.includes(planMarker)) {
        return { id: c.id, body: c.body };
      }
    }
  }
  return null;
}

async function recordUsage(options: RecordOptions): Promise<number> {
  const targetNum = parseTarget(options.target);
  const repo = process.env.AGENT_USAGE_AUDIT_REPO || ":owner/:repo";

  let record: UsageRecord;
  if (options.recordFile) {
    record = JSON.parse(readFileSync(options.recordFile, "utf-8"));
  } else {
    record = await probe(options.stage, options.session);
  }

  const existingComment = findAuditComment(targetNum, repo);
  const existingRecords = existingComment ? parseAuditComment(existingComment.body) : [];
  const mergedRecords = mergeLedger(existingRecords, record);
  const rendered = renderAuditComment(mergedRecords);

  const byteLen = Buffer.byteLength(rendered, "utf8");
  if (byteLen > GH_COMMENT_MAX_BYTES) {
    console.error(`audit comment exceeds GitHub limit of ${GH_COMMENT_MAX_BYTES} characters (actual: ${byteLen})`);
    return 1;
  }

  if (options.dryRun) {
    console.log(rendered);
    return 0;
  }

  // gh api reads the field value from a file via @, keeping the body out of
  // argv so shell-quoting can never mangle the comment.
  const tmpFile = path.join(homedir(), `.audit-comment-${Date.now()}-${Math.random().toString(36).slice(2)}.tmp`);
  await Bun.write(tmpFile, rendered);

  try {
    if (existingComment) {
      runGh(["api", "-X", "PATCH", `repos/${repo}/issues/comments/${existingComment.id}`, "-F", `body=@${tmpFile}`]);
    } else {
      runGh(["api", "-X", "POST", `repos/${repo}/issues/${targetNum}/comments`, "-F", `body=@${tmpFile}`]);
    }
    return 0;
  } finally {
    try {
      unlinkSync(tmpFile);
    } catch {}
  }
}

function parseArgs(argv: string[]): {
  command: string;
  stage?: string;
  session?: string;
  existing?: string;
  record?: string;
  file?: string;
  target?: string;
  dryRun?: boolean;
} {
  const [command = "", ...rest] = argv;
  const parsed: {
    command: string;
    stage?: string;
    session?: string;
    existing?: string;
    record?: string;
    file?: string;
    target?: string;
    dryRun?: boolean;
  } = { command };
  for (let i = 0; i < rest.length; i++) {
    if (rest[i] === "--stage") {
      if (!rest[i + 1] || rest[i + 1].startsWith("--")) throw new Error("missing argument for --stage");
      parsed.stage = rest[i + 1];
    } else if (rest[i] === "--session") {
      if (!rest[i + 1] || rest[i + 1].startsWith("--")) throw new Error("missing argument for --session");
      parsed.session = rest[i + 1];
    } else if (rest[i] === "--existing") {
      if (!rest[i + 1] || rest[i + 1].startsWith("--")) throw new Error("missing argument for --existing");
      parsed.existing = rest[i + 1];
    } else if (rest[i] === "--record") {
      if (!rest[i + 1] || rest[i + 1].startsWith("--")) throw new Error("missing argument for --record");
      parsed.record = rest[i + 1];
    } else if (rest[i] === "--file") {
      if (!rest[i + 1] || rest[i + 1].startsWith("--")) throw new Error("missing argument for --file");
      parsed.file = rest[i + 1];
    } else if (rest[i] === "--target") {
      if (!rest[i + 1] || rest[i + 1].startsWith("--")) throw new Error("missing argument for --target");
      parsed.target = rest[i + 1];
    } else if (rest[i] === "--dry-run") {
      parsed.dryRun = true;
      continue;
    } else {
      throw new Error(`unexpected argument: ${rest[i]}`);
    }
    i += 1;
  }
  return parsed;
}

async function main(argv: string[]): Promise<number> {
  let args;
  try {
    args = parseArgs(argv);
  } catch (error) {
    console.error(error instanceof Error ? error.message : String(error));
    return 2;
  }
  if (args.command === "merge") {
    if (!args.record) {
      console.error("usage: agent-usage-audit merge --existing <file> --record <file>");
      return 2;
    }
    try {
      const existing: LedgerEnvelope = args.existing
        ? JSON.parse(readFileSync(args.existing, "utf8")) as LedgerEnvelope
        : { schema: SCHEMA, records: [] };
      const newRecord = JSON.parse(readFileSync(args.record, "utf8")) as UsageRecord;
      const envelope: LedgerEnvelope = { schema: SCHEMA, records: mergeLedger(existing.records, newRecord) };
      console.log(JSON.stringify(envelope, null, 2));
      return 0;
    } catch (error) {
      console.error(error instanceof Error ? error.message : String(error));
      return 2;
    }
  }
  if (args.command === "render") {
    try {
      const input = args.file ? readFileSync(args.file, "utf8") : await Bun.stdin.text();
      const ledger = JSON.parse(input) as LedgerEnvelope;
      console.log(renderAuditComment(ledger.records));
      return 0;
    } catch (error) {
      console.error(error instanceof Error ? error.message : String(error));
      return 2;
    }
  }
  if (args.command === "parse") {
    try {
      const input = args.file ? readFileSync(args.file, "utf8") : await Bun.stdin.text();
      const envelope: LedgerEnvelope = { schema: SCHEMA, records: parseAuditComment(input) };
      console.log(JSON.stringify(envelope, null, 2));
      return 0;
    } catch (error) {
      console.error(error instanceof Error ? error.message : String(error));
      return 2;
    }
  }
  if (args.command === "record") {
    if (!args.stage || !args.target) {
      console.error("usage: agent-usage-audit record --stage <stage> [--session <id>] --target <issue:N|pr:M> [--dry-run] [--record <file>]");
      return 2;
    }
    if (!isStage(args.stage)) {
      console.error("--stage must be a kebab-case identifier");
      return 2;
    }
    try {
      return await recordUsage({
        stage: args.stage,
        session: args.session,
        target: args.target,
        dryRun: args.dryRun,
        recordFile: args.record,
      });
    } catch (error) {
      console.error(error instanceof Error ? error.message : String(error));
      return 2;
    }
  }
  if (args.command !== "probe" || !args.stage) {
    console.error("usage: agent-usage-audit probe --stage <stage> [--session <id>]");
    return 2;
  }
  if (!isStage(args.stage)) {
    console.error("--stage must be a kebab-case identifier");
    return 2;
  }
  try {
    const record = await probe(args.stage, args.session);
    console.log(JSON.stringify(record, null, 2));
    return 0;
  } catch (error) {
    const harness = detectHarness();
    const sessionId = args.session ?? detectSessionId(harness);
    const fallback = unavailableRecord(
      args.stage,
      harness,
      sessionId,
      `unexpected probe error: ${error instanceof Error ? error.message : String(error)}`,
    );
    console.log(JSON.stringify(fallback, null, 2));
    return 0;
  }
}

process.exit(await main(process.argv.slice(2)));
